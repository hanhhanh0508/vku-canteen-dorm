{
  "info": {
    "name": "VKU Canteen Dorm - Module 3 (Order System - Lệ)",
    "_postman_id": "vku-canteen-order-module3-le-2026",
    "description": "Bộ API kiểm thử Module 3: Đặt hàng KTX & Quản lý đơn hàng của Sinh viên (Lệ)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Đăng nhập Sinh viên (Lấy Bearer Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"hungvm.23it@vku.udn.vn\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Sinh viên tạo đơn đặt món về KTX (Create Order)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer <TOKEN_SINH_VIEN>",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"canteenId\": \"<ID_CAN_TIN>\",\n  \"items\": [\n    {\n      \"foodId\": \"<ID_MON_AN>\",\n      \"quantity\": 2\n    }\n  ],\n  \"dormBlock\": \"Khu A\",\n  \"roomNumber\": \"P.302\",\n  \"phone\": \"0905123456\",\n  \"note\": \"Giao trước 12h, không cay\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "3. Sinh viên xem lịch sử đơn cá nhân (Get My Orders)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <TOKEN_SINH_VIEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/orders/my-orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "orders",
            "my-orders"
          ]
        }
      }
    },
    {
      "name": "4. Xem chi tiết đơn hàng theo ID (Get Order By ID)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <TOKEN_SINH_VIEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/orders/<ID_DON_HANG>",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "orders",
            "<ID_DON_HANG>"
          ]
        }
      }
    },
    {
      "name": "5. Sinh viên hủy đơn hàng (Cancel Order - Khi đang Chờ xác nhận)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <TOKEN_SINH_VIEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/orders/<ID_DON_HANG>/cancel",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "orders",
            "<ID_DON_HANG>",
            "cancel"
          ]
        }
      }
    }
  ]
}

