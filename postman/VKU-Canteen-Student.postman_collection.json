{
  "info": {
    "_postman_id": "vku-canteen-student-week3-le",
    "name": "VKU Canteen & Dorm Delivery - Phân hệ Sinh viên (Lệ)",
    "description": "Postman Collection hoàn chỉnh cho Phân hệ Sinh viên đặt hàng KTX trong Tuần 3 (Module 4 + Frontend). Bao gồm API Auth, Canteen, Category, Food và toàn bộ các kịch bản kiểm thử Order (Valid, Validation KTX, Out of Stock, RBAC 403).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "canteenId",
      "value": "65f0a1b2c3d4e5f6a7b8c9d0",
      "type": "string"
    },
    {
      "key": "foodId",
      "value": "65f0a1b2c3d4e5f6a7b8c9d1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "65f0a1b2c3d4e5f6a7b8c9d2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực (Auth)",
      "item": [
        {
          "name": "POST /api/auth/login - Đăng nhập tài khoản Sinh viên",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.collectionVariables.set('studentToken', res.token);",
                  "        console.log('✅ Đã tự động lưu studentToken vào collection variable');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"le.student@vku.udn.vn\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập với vai trò Sinh viên (role: 'student') để lấy JWT Bearer Token lưu vào {{studentToken}}."
          }
        }
      ]
    },
    {
      "name": "2. Căn tin & Thực đơn (Canteen & Menu)",
      "item": [
        {
          "name": "GET /api/canteens - Lấy danh sách tất cả Căn tin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/canteens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "canteens"]
            },
            "description": "Lấy danh sách các Căn tin phục vụ tại VKU để hiển thị lên dropdown chọn quán."
          }
        },
        {
          "name": "GET /api/categories?canteen=<id> - Lấy danh mục theo Căn tin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories?canteen={{canteenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"],
              "query": [
                {
                  "key": "canteen",
                  "value": "{{canteenId}}"
                }
              ]
            },
            "description": "Lấy danh sách các danh mục món (Cơm, Bún, Nước uống...) thuộc Căn tin đã chọn."
          }
        },
        {
          "name": "GET /api/foods?canteen=<id> - Lấy thực đơn món ăn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/foods?canteen={{canteenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "foods"],
              "query": [
                {
                  "key": "canteen",
                  "value": "{{canteenId}}"
                }
              ]
            },
            "description": "Lấy danh sách món ăn của Căn tin, bao gồm tên, giá, ảnh, mô tả và trạng thái isAvailable (Còn/Hết món)."
          }
        }
      ]
    },
    {
      "name": "3. Đặt hàng KTX (Order)",
      "item": [
        {
          "name": "POST /api/orders - Đặt đơn hợp lệ chuẩn KTX",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.order && res.order._id) {",
                  "        pm.collectionVariables.set('orderId', res.order._id);",
                  "        console.log('✅ Đã lưu orderId mới tạo:', res.order._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canteenId\": \"{{canteenId}}\",\n  \"items\": [\n    {\n      \"foodId\": \"{{foodId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"dormBlock\": \"Khu A\",\n  \"roomNumber\": \"P.302\",\n  \"phone\": \"0901234567\",\n  \"note\": \"Giao giờ trưa, không ớt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Đặt đơn hàng KTX thành công. Backend tự động tính totalAmount từ DB, gắn student từ Token và khởi tạo status 'Chờ xác nhận'."
          }
        },
        {
          "name": "POST /api/orders - [Test] Thiếu thông tin KTX (dormBlock/roomNumber/phone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canteenId\": \"{{canteenId}}\",\n  \"items\": [\n    {\n      \"foodId\": \"{{foodId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"dormBlock\": \"\",\n  \"roomNumber\": \"\",\n  \"phone\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Kiểm thử chặn lỗi 400 khi thiếu thông tin giao hàng KTX."
          }
        },
        {
          "name": "POST /api/orders - [Test] Tòa KTX không hợp lệ (Kỳ vọng 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canteenId\": \"{{canteenId}}\",\n  \"items\": [\n    {\n      \"foodId\": \"{{foodId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"dormBlock\": \"Khu C\",\n  \"roomNumber\": \"P.201\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Kiểm thử chặn tòa KTX ngoài danh mục VKU (Khu C). Kỳ vọng 400: 'Tòa KTX không hợp lệ. Vui lòng chọn Khu A, Khu B hoặc Khu K.'"
          }
        },
        {
          "name": "POST /api/orders - [Test] Đặt món đã hết hàng (Kỳ vọng 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canteenId\": \"{{canteenId}}\",\n  \"items\": [\n    {\n      \"foodId\": \"{{foodId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"dormBlock\": \"Khu A\",\n  \"roomNumber\": \"P.302\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Kiểm thử chặn đặt món khi Food có isAvailable = false. Kỳ vọng 400: 'Món <tên món> hiện đã hết món.'"
          }
        },
        {
          "name": "GET /api/orders/my-orders - Danh sách đơn của Sinh viên",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my-orders"]
            },
            "description": "Lấy danh sách các đơn hàng của chính tài khoản sinh viên đang đăng nhập, sắp xếp mới nhất lên đầu."
          }
        },
        {
          "name": "GET /api/orders/:id - Xem chi tiết đơn của chính mình",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "Sinh viên xem chi tiết đơn do chính mình tạo (Populate student, canteen, items.food). Kỳ vọng 200 OK."
          }
        },
        {
          "name": "GET /api/orders/:id - [Test RBAC] Xem đơn người khác (Kỳ vọng 403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/65f0a1b2c3d4e5f6a7b8c999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "65f0a1b2c3d4e5f6a7b8c999"]
            },
            "description": "Kiểm thử phân quyền RBAC: Sinh viên xem ID đơn của sinh viên khác. Kỳ vọng 403 Forbidden: 'Bạn không có quyền xem đơn hàng này.'"
          }
        }
      ]
    }
  ]
}
